{
  "entryPointStrategy": "resolve",
  "entryPoints": ["packages/*/src/flat/index.ts", "packages/*/src/sdk/index.ts"],
  "tsconfig": "tsconfig.base.json",
  "out": "docs",
  "excludePrivate": true,
  "excludeInternal": true,
  "readme": "none",
  // OpenAPI-generated comments often link to paths that are not in this repo.
  "validation": {
    "invalidPath": false,
  },
}
