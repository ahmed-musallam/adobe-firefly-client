{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "unicorn/no-thenable": "off"
  },
  "ignorePatterns": ["**/src/flat/**", "**/src/sdk/**", "**/dist/**"]
}
